{
  "name": "skill-benchmarks",
  "version": "0.1.0",
  "description": "Deterministic, high-throughput LLM agent skill benchmarking and evaluation harness",
  "type": "module",
  "bin": {
    "skill-benchmarks": "bin/skill-benchmarks"
  },
  "files": [
    "bin/",
    "src/",
    "scenarios/",
    "skill-list/",
    "docs/usage-guide/",
    "docs/architecture/",
    "README.md"
  ],
  "scripts": {
    "test": "bun run typecheck",
    "typecheck": "tsc --noEmit && bun src/scripts/quality-gate.ts",
    "gc:containers": "bun run src/infrastructure/container/gc.ts",
    "sync:skills": "bun run src/scripts/sync-skills.ts",
    "verify:ci-diagnostic": "bun run src/scripts/verify-ci-diagnostic.ts",
    "cli": "bun run bin/skill-benchmarks"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "bun-types": "^1.4.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "oxc-parser": "^0.147.0"
  }
}
